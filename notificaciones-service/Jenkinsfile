// Pipeline CI de notificaciones-service (Go / SQLite / RabbitMQ)
// Etapas: Checkout -> Build & Test -> SonarQube -> Quality Gate -> Package & Publish.
// El E2E del sistema completo lo ejecuta el job 'e2e-bdd' (no se repite en cada servicio).
pipeline {
    agent none

    // RUN_SONAR=false permite correr el pipeline sin SonarQube (equipos con poca RAM).
    parameters {
        booleanParam(name: 'RUN_SONAR', defaultValue: true,
                     description: 'Ejecutar analisis SonarQube y Quality Gate')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            agent any
            steps {
                checkout scm
                stash name: 'src', includes: 'notificaciones-service/**',
                      excludes: 'notificaciones-service/reports/**'
            }
        }

        stage('Build & Test') {
            agent {
                docker {
                    image 'golang:alpine'
                    args '-u root -v go_cache:/go/pkg/mod'
                }
            }
            steps {
                unstash 'src'
                dir('notificaciones-service') {
                    sh 'mkdir -p reports'
                    sh 'go vet ./...'
                    // Los tests fallidos no rompen aqui; el resumen queda en reports/test.log.
                    sh 'go test ./... -covermode=atomic -coverprofile=reports/coverage.out -v 2>&1 | tee reports/test.log || true'
                    sh 'go tool cover -func=reports/coverage.out | tail -n 1'
                }
                // Los reportes los necesita el analisis de SonarQube.
                stash name: 'reportes', includes: 'notificaciones-service/reports/**', allowEmpty: true
            }
            post {
                always {
                    archiveArtifacts artifacts: 'notificaciones-service/reports/**', allowEmptyArchive: true
                    sh 'chown -R 1000:1000 notificaciones-service || true'
                }
            }
        }

        // Analisis estatico + cobertura. Usa sonar-project.properties del servicio.
        stage('SonarQube') {
            when { expression { params.RUN_SONAR == true } }
            agent {
                docker {
                    image 'sonarsource/sonar-scanner-cli:5.0.1'
                    // --network: para alcanzar a SonarQube por su nombre ('sonarqube').
                    args '-u root --network proyecto-microservicios_microservices-network --entrypoint='
                }
            }
            steps {
                unstash 'src'
                unstash 'reportes'
                dir('notificaciones-service') {
                    withSonarQubeEnv('sonarqube') {
                        sh 'sonar-scanner -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_AUTH_TOKEN'
                    }
                }
            }
        }

        // Espera el veredicto de SonarQube (llega por el webhook). Si el gate (cobertura >= 70%) falla: FAILURE.
        stage('Quality Gate') {
            when { expression { params.RUN_SONAR == true } }
            agent any
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // Solo se publica si todo lo anterior salio SUCCESS (no se publica con tests rotos).
        stage('Package & Publish') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            agent any
            environment {
                IMAGE = 'localhost:5000/microservicios/notificaciones-service'
            }
            steps {
                checkout scm
                sh 'docker build -t $IMAGE:$BUILD_NUMBER -t $IMAGE:latest notificaciones-service'
                sh 'docker push $IMAGE:$BUILD_NUMBER'
                sh 'docker push $IMAGE:latest'
            }
            post {
                always {
                    // Libera espacio en el disco del runner (importante con 8 GB de RAM)
                    sh 'docker rmi $IMAGE:$BUILD_NUMBER $IMAGE:latest || true'
                }
            }
        }
    }
}
