# Copie este archivo como .env (no se sube al repositorio) y ajuste los valores.
# Los valores de ejemplo coinciden con los usuarios semilla del .env.example de la raiz.

# URL base del sistema: el API Gateway
BASE_URL=http://localhost:8080

# Credenciales de los usuarios de prueba
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Admin123!
USER_EMAIL=user@empresa.com
USER_PASSWORD=User123!
