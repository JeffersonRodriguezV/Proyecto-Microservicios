# =============================================================================
# Plantilla de configuración. NO contiene secretos reales.
#
#   1) cp .env.example .env
#   2) bash scripts/setup-secrets.sh        (en Windows: scripts\setup-secrets.ps1)
#
# El script reemplaza cada CHANGE_ME por un valor aleatorio generado en su máquina.
# El archivo .env está en .gitignore: nunca se sube al repositorio.
# =============================================================================

# --- Autenticación (JWT compartido por auth-service y el Gateway; mínimo 32 caracteres) ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION_MINUTES=60
JWT_RESET_EXPIRATION_MINUTES=60

# --- Usuarios semilla (los crea auth-service al arrancar y los usan las pruebas BDD) ---
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=CHANGE_ME
SEED_USER_EMAIL=user@empresa.com
SEED_USER_PASSWORD=CHANGE_ME

# --- Message broker (RabbitMQ) ---
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=CHANGE_ME

# --- Bases de datos (una por microservicio) ---
DB_EMPLEADOS_USER=empleados_user
DB_EMPLEADOS_PASSWORD=CHANGE_ME
DB_EMPLEADOS_ROOT_PASSWORD=CHANGE_ME
DB_AUTH_PASSWORD=CHANGE_ME
DB_AUTH_ROOT_PASSWORD=CHANGE_ME
DB_DEPARTAMENTOS_PASSWORD=CHANGE_ME

# --- Observabilidad (Reto 8): clave del usuario admin de Grafana (http://localhost:3000) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Webhook de Discord donde Grafana envia las alertas (Canal > Integraciones > Webhooks)
DISCORD_WEBHOOK_URL=

# --- CI (Reto 7): Jenkins y SonarQube ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=CHANGE_ME
SONAR_DB_PASSWORD=CHANGE_ME
# Token de SonarQube: se genera dentro de SonarQube (Mi cuenta > Seguridad) y se pega aquí a mano.
SONAR_TOKEN=pendiente

# --- Desarrollo ---
# Endpoints de desarrollo (necesarios para los escenarios de vacaciones). Déjelo en false fuera de pruebas.
DEV_ENDPOINTS=true
