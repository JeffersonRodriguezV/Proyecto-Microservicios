# =============================================================================
# Configuración NO secreta. Los secretos (claves, contraseñas, tokens) ya no van aquí:
# viven como archivos en la carpeta secrets/ (Docker Compose Secrets).
#
#   1) bash scripts/setup-secrets.sh        (en Windows: scripts\setup-secrets.ps1)
#      Crea .env (a partir de este archivo) y genera secrets/ con valores aleatorios.
#
# .env y secrets/ están en .gitignore: nunca se suben al repositorio.
# Plantilla de la carpeta de secretos: secrets.example/
# =============================================================================

# --- Autenticación ---
JWT_EXPIRATION_MINUTES=60
JWT_RESET_EXPIRATION_MINUTES=60

# --- Usuarios semilla (los crea auth-service al arrancar; las claves están en secrets/) ---
ADMIN_EMAIL=admin@empresa.com
SEED_USER_EMAIL=user@empresa.com

# --- Message broker (RabbitMQ): usuario; la clave está en secrets/rabbitmq_password ---
RABBITMQ_USERNAME=admin

# --- Bases de datos: usuario de empleados; las claves están en secrets/ ---
DB_EMPLEADOS_USER=empleados_user

# --- CI: usuario administrador de Jenkins (la clave está en secrets/jenkins_admin_password) ---
JENKINS_ADMIN_ID=admin

# --- Desarrollo ---
# Endpoints de desarrollo (necesarios para los escenarios de vacaciones). Déjelo en false fuera de pruebas.
DEV_ENDPOINTS=true

# --- Escalado (Traefik reparte entre réplicas). Con poca RAM use 1 ---
GATEWAY_REPLICAS=2
EMPLEADOS_REPLICAS=2
