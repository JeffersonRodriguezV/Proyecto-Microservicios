// Pipeline CI de perfiles-service (.NET 10 / minimal API / xunit)
// Etapas: Checkout -> Build & Test -> SonarQube -> Quality Gate -> Package & Publish.
// El E2E del sistema completo lo ejecuta el job 'e2e-bdd' (no se repite en cada servicio).
pipeline {
    agent none

    // RUN_SONAR=false permite correr el pipeline sin SonarQube (equipos con poca RAM).
    parameters {
        booleanParam(name: 'RUN_SONAR', defaultValue: true,
                     description: 'Ejecutar analisis SonarQube y Quality Gate')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            agent any
            steps {
                checkout scm
                stash name: 'src', includes: 'perfiles-service/**,perfiles-service.Tests/**',
                      excludes: '**/bin/**,**/obj/**,**/reports/**,**/TestResults/**'
            }
        }

        // Reutiliza perfiles-service.Tests/run-tests.sh, que espera el repo en /repo y los reportes en /reports.
        stage('Build & Test') {
            agent {
                docker {
                    image 'mcr.microsoft.com/dotnet/sdk:10.0'
                    args '-u root -v nuget_cache:/root/.nuget/packages'
                }
            }
            steps {
                unstash 'src'
                sh '''
                    ln -sfn "$PWD" /repo
                    mkdir -p /reports
                    # Los tests fallidos no rompen aqui: el paso junit marca UNSTABLE.
                    bash perfiles-service.Tests/run-tests.sh || true
                    mkdir -p perfiles-service/reports
                    cp /reports/junit.xml perfiles-service/reports/junit.xml || true
                    find /reports/coverage -name 'coverage.cobertura.xml' -exec cp {} perfiles-service/reports/coverage.cobertura.xml \\; || true
                    find /reports/coverage -name 'coverage.opencover.xml' -exec cp {} perfiles-service/reports/coverage.opencover.xml \\; || true
                    find /reports/coverage -name 'coverage.info' -exec cp {} perfiles-service/reports/lcov.info \\; || true
                '''
                stash name: 'reportes', includes: 'perfiles-service/reports/**', allowEmpty: true
            }
            post {
                always {
                    junit testResults: 'perfiles-service/reports/junit.xml', allowEmptyResults: true
                    recordCoverage(
                        tools: [[parser: 'COBERTURA', pattern: 'perfiles-service/reports/coverage.cobertura.xml']],
                        sourceCodeRetention: 'LAST_BUILD'
                    )
                    sh 'chown -R 1000:1000 perfiles-service perfiles-service.Tests || true'
                }
            }
        }

        // Analisis estatico + cobertura. Usa sonar-project.properties del servicio.
        stage('SonarQube') {
            when { expression { params.RUN_SONAR == true } }
            agent {
                docker {
                    image 'sonarsource/sonar-scanner-cli:5.0.1'
                    // --network: para alcanzar a SonarQube por su nombre ('sonarqube').
                    args '-u root --network proyecto-microservicios_microservices-network --entrypoint='
                }
            }
            steps {
                unstash 'src'
                unstash 'reportes'
                dir('perfiles-service') {
                    withSonarQubeEnv('sonarqube') {
                        sh 'sonar-scanner -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_AUTH_TOKEN'
                    }
                }
            }
        }

        // Espera el veredicto de SonarQube (llega por el webhook). Si el gate (cobertura >= 70%) falla: FAILURE.
        stage('Quality Gate') {
            when { expression { params.RUN_SONAR == true } }
            agent any
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // Solo se publica si todo lo anterior salio SUCCESS (no se publica con tests rotos).
        stage('Package & Publish') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            agent any
            environment {
                IMAGE = 'localhost:5000/microservicios/perfiles-service'
            }
            steps {
                checkout scm
                sh 'docker build -t $IMAGE:$BUILD_NUMBER -t $IMAGE:latest perfiles-service'
                sh 'docker push $IMAGE:$BUILD_NUMBER'
                sh 'docker push $IMAGE:latest'
            }
            post {
                always {
                    // Libera espacio en el disco del runner (importante con 8 GB de RAM)
                    sh 'docker rmi $IMAGE:$BUILD_NUMBER $IMAGE:latest || true'
                }
            }
        }
    }
}
