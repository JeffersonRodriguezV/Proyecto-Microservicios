  "item": [
    {
      "name": "Registrar un departamento",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('El body devuelve el departamento creado', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql('IT');",
              "    pm.expect(jsonData.nombre).to.eql('Tecnologia');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"id\": \"IT\",\r\n  \"nombre\": \"Tecnologia\",\r\n  \"descripcion\": \"Departamento de TI\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8081/departamentos",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
