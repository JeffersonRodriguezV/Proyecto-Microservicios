    {
      "name": "08 - Perfil creado por evento (empleado.creado)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/perfiles/{{empleadoIdVacaciones}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "perfiles",
            "{{empleadoIdVacaciones}}"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Pequena espera: el perfil se crea de forma asincrona al consumir el evento",
              "setTimeout(function () {}, 1500);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('El perfil corresponde al empleado', function () {",
              "    const p = pm.response.json();",
              "    pm.expect(String(p.empleadoId)).to.eql(pm.collectionVariables.get('empleadoIdVacaciones'));",
              "    pm.expect(p.nombre).to.eql('Marta');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Notificaciones del empleado (BIENVENIDA y VACACIONES)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/notificaciones/{{empleadoIdVacaciones}}",
          "protocol": "http",
