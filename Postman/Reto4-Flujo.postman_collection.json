          "mode": "raw",
          "raw": "{\n  \"empleadoId\": \"{{empleadoIdVacaciones}}\",\n  \"fechaInicio\": \"{{fechaInicio}}\",\n  \"fechaFin\": \"{{fechaFin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Estado PROGRAMADA', function () {",
              "    pm.expect(pm.response.json().estado).to.eql('PROGRAMADA');",
              "});"
            ]
          }
        }
      ]
    },
