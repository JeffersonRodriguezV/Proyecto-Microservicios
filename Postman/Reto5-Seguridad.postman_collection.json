          "raw": "{\"nombre\": \"Pedro\", \"apellido\": \"Prueba\", \"email\": \"pedro{{rnd}}@empresa.com\", \"numeroEmpleado\": \"EMP-{{rnd}}\", \"cargo\": \"QA\", \"area\": \"IT\", \"departamentoId\": \"D{{rnd}}\", \"fechaIngreso\": \"2026-03-01\"}",
