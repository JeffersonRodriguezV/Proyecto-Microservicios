{
  "info": {
    "_postman_id": "d5a2f9c1-reto5-seguridad-jwt",
    "name": "Reto5-Seguridad",
    "description": "Flujo de seguridad del Reto 5 sobre el Gateway (http://localhost:8080): 401 sin token o alterado, RBAC (ADMIN/USER), propiedad del recurso, onboarding con token de activacion, cambio y recuperacion de contrasena, y offboarding. Ejecutar con el Collection Runner, en orden. Repetible: genera datos nuevos en cada corrida.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenAdmin}}",
        "type": "string"
      }
    ]
  },
