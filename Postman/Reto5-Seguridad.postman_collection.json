            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var j = pm.response.json();",
              "pm.test('Empleado ACTIVO', function () {",
              "    pm.expect(j.estado).to.eql('ACTIVO');",
              "});",
              "pm.collectionVariables.set('empleadoId', String(j.id));",
              "pm.collectionVariables.set('userEmail', j.email);"
            ]
