            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@empresa.com\", \"password\": \"Admin123!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var j = pm.response.json();",
              "pm.test('Devuelve accessToken', function () {",
              "    pm.expect(j.accessToken).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('tokenAdmin', j.accessToken);"
            ]
          }
        }
      ]
