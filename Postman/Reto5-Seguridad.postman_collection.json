    {
      "name": "05 - Obtener token de activacion (notificaciones)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/notificaciones/{{empleadoId}}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 4000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var n = pm.response.json().find(function (x) { return x.tipo === 'SEGURIDAD'; });",
              "pm.test('Llego la notificacion SEGURIDAD', function () {",
              "    pm.expect(n).to.exist;",
              "});",
              "var m = n ? /token=([\\w\\-.]+)/.exec(n.mensaje) : null;",
              "pm.test('El mensaje trae el token de activacion', function () {",
              "    pm.expect(m).to.not.be.null;",
              "});",
              "if (m) { pm.collectionVariables.set('tokenActivacion', m[1]); }"
            ]
          }
        }
      ]
    },
