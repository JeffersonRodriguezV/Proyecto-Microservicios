<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<!-- Información del proyecto -->
	<groupId>com.microservicios</groupId>
	<artifactId>gestionempleados</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>gestionempleados</name>
	<description>Microservicio de gestión de empleados</description>

	<!-- Java -->
	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>

		<!-- ====================================== -->
		<!-- WEB / REST API                         -->
		<!-- @RestController, @GetMapping, etc.   -->
		<!-- ====================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- ====================================== -->
		<!-- JPA / HIBERNATE / DATABASE             -->
		<!-- @Entity, @Id, @GeneratedValue, etc.  -->
		<!-- JpaRepository                         -->
		<!-- ====================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>

		</dependency>

		<!-- ====================================== -->
		<!-- VALIDATION                             -->
		<!-- @Valid, @NotNull, @NotBlank,         -->
		<!-- @Size, @Email, etc.                   -->
		<!-- ====================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- ====================================== -->
		<!-- BASE DE DATOS MYSQL                     -->
		<!-- ====================================== -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ====================================== -->
		<!-- ACTUATOR                               -->
		<!-- Health checks y monitorización        -->
		<!-- ====================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- ====================================== -->
		<!-- LOMBOK                                 -->
		<!-- @Getter, @Setter, @Builder, etc.     -->
		<!-- ====================================== -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ====================================== -->
		<!-- TESTS                                  -->
		<!-- JUnit, Mockito, Spring Test, etc.    -->
		<!-- ====================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Integración con MySQL real (Reto 6). Versiones gestionadas por el BOM de Spring Boot -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mysql</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ====================================== -->
		<!-- RETRY                                  -->
		<!-- @Retryable, @Backoff, @Recover        -->
		<!-- ====================================== -->
		<dependency>
			<groupId>org.springframework.retry</groupId>
			<artifactId>spring-retry</artifactId>
			<version>2.0.5</version>
		</dependency>

		<!-- ====================================== -->
		<!-- CIRCUIT BREAKER                        -->
		<!-- @CircuitBreaker                        -->
		<!-- ====================================== -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot3</artifactId>
			<version>2.2.0</version>
		</dependency>

		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-aop</artifactId>
		</dependency>
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- ====================================== -->
		<!-- OPENAPI / SWAGGER                      -->
		<!-- Documentación interactiva de la API   -->
		<!-- ====================================== -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.7.0</version>
		</dependency>

		<!-- ====================================== -->
		<!-- MENSAJERÍA (RabbitMQ)                  -->
		<!-- ====================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>

			<!-- Spring Boot Maven Plugin -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- JaCoCo (Reto 6): cobertura. `mvnw test` genera target/site/jacoco/jacoco.xml (+ index.html);
				 `mvnw verify` además exige >= 70 % de líneas. Solo se excluye código SIN lógica (ver <excludes>). -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<configuration>
					<excludes>
						<!-- Entidades: solo campos, getters y setters -->
						<exclude>**/model/**</exclude>
						<!-- DTOs: records/POJOs sin lógica -->
						<exclude>**/dto/**</exclude>
						<!-- Cuerpo de respuesta de errores: un record -->
						<exclude>**/exception/ErrorResponse*</exclude>
						<!-- Arranque de Spring y configuración declarativa (beans/OpenAPI/colas) -->
						<exclude>**/*Application.class</exclude>
						<exclude>**/config/OpenApiConfig*</exclude>
						<exclude>**/*RabbitMQConfig*</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals><goal>report</goal></goals>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals><goal>check</goal></goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.70</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>