// Pipeline CI de empleados-service (Java 21 / Spring Boot / Maven)
// Etapas actuales: Checkout -> Build -> Test (con cobertura JaCoCo).
// Siguientes (Reto 7): SonarQube + Quality Gate, Package/Publish, E2E.
pipeline {
    // Cada stage declara su propio agente (el E2E necesitara Docker en el host).
    agent none

    // RUN_SONAR=false permite ejecutar el pipeline sin SonarQube (equipos con poca RAM).
    // Por defecto (builds normales) el analisis y el Quality Gate SI corren.
    parameters {
        booleanParam(name: 'RUN_SONAR', defaultValue: true,
                     description: 'Ejecutar analisis SonarQube y Quality Gate')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            agent any
            steps {
                checkout scm
                // Se guarda el workspace para que los agentes Maven lo reutilicen sin repetir el clone.
                stash name: 'src', includes: 'empleados-service/**'
            }
        }

        // Agente Maven con cache de ~/.m2 y docker.sock (por si los tests usan Testcontainers).
        stage('Build & Test') {
            agent {
                docker {
                    image 'maven:3.9-eclipse-temurin-21'
                    // --network: para que el agente alcance a SonarQube por su nombre ('sonarqube').
                    // El nombre depende de la carpeta del proyecto (docker compose <carpeta>_microservices-network).
                    args '-u root -v maven_cache:/root/.m2 -v /var/run/docker.sock:/var/run/docker.sock ' +
                         '--add-host=host.docker.internal:host-gateway ' +
                         '--network proyecto-microservicios_microservices-network'
                }
            }
            environment {
                TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal'
            }
            steps {
                unstash 'src'
                dir('empleados-service') {
                    // Compilar: si falla, el build termina en FAILURE.
                    sh 'mvn -B -q clean compile -DskipTests'

                    // Tests + JaCoCo. Los tests fallidos NO rompen aqui: marcan UNSTABLE.
                    // (mvn verify aplica ademas el minimo de 70% de cobertura definido en el pom)
                    sh 'mvn -B verify -Dmaven.test.failure.ignore=true'

                    // Analisis estatico + cobertura hacia SonarQube.
                    // withSonarQubeEnv inyecta SONAR_HOST_URL y el token (credencial 'sonar-token').
                    // 'params.RUN_SONAR == true': en la 1.a ejecucion tras agregar el parametro
                    // Jenkins aun no lo conoce (null) y se omite; despues es true por defecto.
                    script {
                        if (params.RUN_SONAR == true) {
                            withSonarQubeEnv('sonarqube') {
                                sh '''mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                      -Dsonar.projectKey=empleados-service \
                                      -Dsonar.projectName=empleados-service'''
                            }
                        } else {
                            echo 'RUN_SONAR desactivado: se omite el analisis SonarQube'
                        }
                    }
                }
            }
            post {
                always {
                    junit testResults: 'empleados-service/target/surefire-reports/*.xml, empleados-service/target/failsafe-reports/*.xml',
                          allowEmptyResults: true
                    recordCoverage(
                        tools: [[parser: 'JACOCO', pattern: 'empleados-service/target/site/jacoco/jacoco.xml']],
                        sourceDirectories: [[path: 'empleados-service/src/main/java']],
                        sourceCodeRetention: 'LAST_BUILD'
                    )
                    // Devolver el workspace al usuario jenkins para que pueda limpiarlo.
                    sh 'chown -R 1000:1000 empleados-service/target || true'
                }
            }
        }

        // Espera el veredicto de SonarQube (llega por el webhook). Si el gate falla, FAILURE.
        stage('Quality Gate') {
            when { expression { params.RUN_SONAR == true } }
            agent any
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // Construye la imagen del servicio y la publica en el registry local.
        // Solo corre si todo lo anterior salio SUCCESS (no se publica con tests rotos).
        stage('Package & Publish') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            agent any
            environment {
                // El daemon Docker es el del host, por eso 'localhost:5000' es el registry publicado.
                IMAGE = 'localhost:5000/microservicios/empleados-service'
            }
            steps {
                checkout scm
                dir('empleados-service') {
                    sh 'docker build -t $IMAGE:$BUILD_NUMBER -t $IMAGE:latest .'
                }
                sh 'docker push $IMAGE:$BUILD_NUMBER'
                sh 'docker push $IMAGE:latest'
            }
            post {
                always {
                    sh 'docker rmi $IMAGE:$BUILD_NUMBER $IMAGE:latest || true'
                }
                success {
                    echo "Imagen publicada: ${IMAGE}:${BUILD_NUMBER}"
                }
            }
        }

        // E2E: levanta el sistema completo y ejecuta la suite BDD del Reto 6.
        // Pruebas fallidas = UNSTABLE. 'lock' evita que dos pipelines usen el sistema a la vez.
        stage('E2E') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            agent any
            options { lock('e2e-sistema') }
            environment {
                COMPOSE = 'docker compose -f docker-compose.yml -f docker-compose.e2e.yml'
            }
            steps {
                checkout scm
                withCredentials([file(credentialsId: 'env-sistema', variable: 'ENV_SISTEMA'),
                                 file(credentialsId: 'env-e2e',     variable: 'ENV_E2E')]) {
                    sh '''
                        cp "$ENV_SISTEMA" .env
                        cp "$ENV_E2E" e2e-tests/.env

                        # Los scripts SQL van a volumenes: el Docker del host no ve este workspace.
                        for s in auth empleados departamentos; do
                          docker volume rm -f e2e_init_$s >/dev/null 2>&1 || true
                          docker volume create e2e_init_$s >/dev/null
                          docker rm -f init_$s >/dev/null 2>&1 || true
                          docker create --name init_$s -v e2e_init_$s:/dst alpine:3.20 >/dev/null
                          docker cp ${s}-service/database/. init_$s:/dst
                          docker rm init_$s >/dev/null
                        done

                        $COMPOSE down -v || true
                        $COMPOSE up -d --build
                        bash scripts/wait-for-healthy.sh http://host.docker.internal:8080 240
                    '''
                }
                script {
                    docker.image('node:22').inside('--add-host=host.docker.internal:host-gateway') {
                        sh '''
                            cd e2e-tests
                            npm ci
                            BASE_URL=http://host.docker.internal:8080 npx cucumber-js || true
                        '''
                    }
                }
            }
            post {
                always {
                    junit testResults: 'e2e-tests/reports/junit.xml', allowEmptyResults: true
                    script {
                        if (fileExists('e2e-tests/reports/cucumber.json')) {
                            cucumber(jsonReportDirectory: 'e2e-tests/reports',
                                     fileIncludePattern: '**/cucumber.json',
                                     buildStatus: 'UNSTABLE')
                        }
                    }
                    publishHTML(target: [reportDir: 'e2e-tests/reports', reportFiles: 'cucumber.html',
                                         reportName: 'Reporte BDD', keepAll: true,
                                         alwaysLinkToLastBuild: true, allowMissing: true])
                    sh '$COMPOSE logs --no-color > docker-logs.txt || true'
                    archiveArtifacts artifacts: 'docker-logs.txt', allowEmptyArchive: true
                    sh '''
                        $COMPOSE down -v || true
                        docker volume rm -f e2e_init_auth e2e_init_empleados e2e_init_departamentos || true
                        rm -f .env e2e-tests/.env
                    '''
                }
            }
        }
    }
}
