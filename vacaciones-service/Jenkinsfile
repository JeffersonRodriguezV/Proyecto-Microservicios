// Pipeline CI de vacaciones-service (Node.js 22 / Express / node:test)
// Etapas: Checkout -> Build & Test -> SonarQube -> Quality Gate.
// Siguientes (Reto 7): Package/Publish, E2E.
pipeline {
    agent none

    // RUN_SONAR=false permite correr el pipeline sin SonarQube (equipos con poca RAM).
    parameters {
        booleanParam(name: 'RUN_SONAR', defaultValue: true,
                     description: 'Ejecutar analisis SonarQube y Quality Gate')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            agent any
            steps {
                checkout scm
                stash name: 'src', includes: 'vacaciones-service/**',
                      excludes: 'vacaciones-service/node_modules/**,vacaciones-service/reports/**,vacaciones-service/coverage/**'
            }
        }

        stage('Build & Test') {
            agent {
                docker {
                    image 'node:22'
                    args '-u root -v npm_cache:/root/.npm'
                }
            }
            environment {
                NODE_OPTIONS = '--experimental-sqlite'
            }
            steps {
                unstash 'src'
                dir('vacaciones-service') {
                    // Build: dependencias exactas del lock. Si falla, FAILURE.
                    sh 'npm ci'
                    // Test: los tests fallidos no rompen aqui; el paso junit marca UNSTABLE.
                    sh 'npm test || true'
                }
                // Los reportes (lcov) los necesita el analisis de SonarQube.
                stash name: 'reportes', includes: 'vacaciones-service/reports/**', allowEmpty: true
            }
            post {
                always {
                    junit testResults: 'vacaciones-service/reports/junit.xml', allowEmptyResults: true
                    recordCoverage(
                        tools: [[parser: 'LCOV', pattern: 'vacaciones-service/reports/lcov.info']],
                        sourceDirectories: [[path: 'vacaciones-service']],
                        sourceCodeRetention: 'LAST_BUILD'
                    )
                    sh 'chown -R 1000:1000 vacaciones-service || true'
                }
            }
        }

        // Analisis estatico + cobertura. Usa sonar-project.properties del servicio.
        stage('SonarQube') {
            when { expression { params.RUN_SONAR == true } }
            agent {
                docker {
                    image 'sonarsource/sonar-scanner-cli:5.0.1'
                    // --network: para alcanzar a SonarQube por su nombre ('sonarqube').
                    // El nombre depende de la carpeta del proyecto (<carpeta>_microservices-network).
                    args '-u root --network proyecto-microservicios_microservices-network --entrypoint='
                }
            }
            steps {
                unstash 'src'
                unstash 'reportes'
                dir('vacaciones-service') {
                    withSonarQubeEnv('sonarqube') {
                        sh 'sonar-scanner -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_AUTH_TOKEN'
                    }
                }
            }
        }

        // Espera el veredicto de SonarQube (llega por el webhook). Si el gate falla: FAILURE.
        stage('Quality Gate') {
            when { expression { params.RUN_SONAR == true } }
            agent any
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Package & Publish') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            agent any
            environment {
                IMAGEN = 'localhost:5000/microservicios/vacaciones-service'
            }
            steps {
                checkout scm
                // El contexto de build es la carpeta del servicio (ahí están Dockerfile y package.json)
                sh 'docker build -t $IMAGEN:$BUILD_NUMBER -t $IMAGEN:latest vacaciones-service'
                sh 'docker push $IMAGEN:$BUILD_NUMBER'
                sh 'docker push $IMAGEN:latest'
            }
            post {
                always {
                    // Libera espacio en el disco del runner (importante con 8 GB de RAM y disco justo)
                    sh 'docker rmi $IMAGEN:$BUILD_NUMBER $IMAGEN:latest || true'
                }
            }
        }
        stage('E2E Tests') {
            when { expression { currentBuild.currentResult == 'SUCCESS' } }
            agent any
            options { lock('e2e-sistema') }
            environment {
                COMPOSE = 'docker compose -f docker-compose.yml -f docker-compose.e2e.yml'
            }
            steps {
                // El E2E necesita TODO el repositorio (compose y los demás servicios), no solo vacaciones
                checkout scm
                withCredentials([file(credentialsId: 'env-sistema', variable: 'ENV_SISTEMA'),
                                 file(credentialsId: 'env-e2e',     variable: 'ENV_E2E')]) {
                    sh '''
                        cp "$ENV_SISTEMA" .env
                        cp "$ENV_E2E" e2e-tests/.env

                        # Copiar los scripts SQL a volumenes (el Docker del host no ve este workspace)
                        for s in auth empleados departamentos; do
                          docker volume rm -f e2e_init_$s >/dev/null 2>&1 || true
                          docker volume create e2e_init_$s >/dev/null
                          docker rm -f init_$s >/dev/null 2>&1 || true
                          docker create --name init_$s -v e2e_init_$s:/dst alpine:3.20 >/dev/null
                          docker cp ${s}-service/database/. init_$s:/dst
                          docker rm init_$s >/dev/null
                        done

                        $COMPOSE down -v || true
                        $COMPOSE up -d --build
                        bash scripts/wait-for-healthy.sh http://host.docker.internal:8080 240
                    '''
                }
                script {
                    docker.image('node:22').inside('--add-host=host.docker.internal:host-gateway') {
                        sh '''
                            cd e2e-tests
                            npm ci
                            BASE_URL=http://host.docker.internal:8080 npx cucumber-js || true
                        '''
                    }
                }
            }
            post {
                always {
                    junit testResults: 'e2e-tests/reports/junit.xml', allowEmptyResults: true
                    script {
                        if (fileExists('e2e-tests/reports/cucumber.json')) {
                            cucumber(jsonReportDirectory: 'e2e-tests/reports',
                                     fileIncludePattern: '**/cucumber.json',
                                     buildStatus: 'UNSTABLE')
                        }
                    }
                    publishHTML(target: [reportDir: 'e2e-tests/reports', reportFiles: 'cucumber.html',
                                         reportName: 'Reporte BDD', keepAll: true,
                                         alwaysLinkToLastBuild: true, allowMissing: true])
                    sh '$COMPOSE logs --no-color > docker-logs.txt || true'
                    archiveArtifacts artifacts: 'docker-logs.txt', allowEmptyArchive: true
                    sh '''
                        $COMPOSE down -v || true
                        docker volume rm -f e2e_init_auth e2e_init_empleados e2e_init_departamentos || true
                        rm -f .env e2e-tests/.env
                    '''
                }
            }
        }
    }
}